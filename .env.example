# Copy to backend/.env for local runs (python-dotenv loads it automatically),
# or set these as real environment variables / secrets in your hosting platform.

# Required for the AI explanation layer (POST /prescription's `explanation` field).
# Without it, the API still works fully -- explanation is simply returned as null.
GROQ_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# "*" is fine for the default single-service deployment (frontend served
# from the same origin as the API). Tighten this if you split the frontend
# out to its own host later.
ALLOWED_ORIGINS=*
